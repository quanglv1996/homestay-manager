# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_USER=homestay_user
POSTGRES_PASSWORD=homestay_password_change_me
POSTGRES_DB=homestay_db
POSTGRES_PORT=5432

# Database URL for SQLAlchemy
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME=Homestay Manager
VERSION=1.0.0
DEBUG=False

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# Admin User (First time setup)
FIRST_SUPERUSER_EMAIL=admin@homestay.com
FIRST_SUPERUSER_PASSWORD=admin123456
FIRST_SUPERUSER_FULL_NAME=System Admin

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Email (Optional)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@homestay.com
EMAILS_FROM_NAME=Homestay Manager

# Frontend Configuration
VITE_API_URL=http://localhost/api/v1
VITE_APP_NAME=Homestay Manager

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Timezone
TZ=Asia/Ho_Chi_Minh
